<?xml version="1.0" encoding="utf-8"?>
<!-- 所属模块：platforms/android / 应用清单
     文件用途：声明 NativeActivity 启动的应用与桌面入口；SAF 需要的 `MainActivity` 子类随
     `classes.dex` 一起打包，因此 hasCode=true。
     Module: platforms/android / app manifest
     Purpose: Declare the NativeActivity app and its launcher entry; the `MainActivity` subclass
     used by SAF ships inside `classes.dex`, hence hasCode=true. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.surfingstudio.app"
    android:versionCode="7"
    android:versionName="1.2.4">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35" />

    <!-- 编辑器使用 OpenGL ES 3.0 渲染（eframe/glow）。 -->
    <!-- The editor renders through OpenGL ES 3.0 (eframe/glow). -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.audio.output" android:required="true" />

    <application
        android:label="SurfingStudio"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:allowBackup="true"
        android:debuggable="true">

        <activity
            android:name="com.surfingstudio.app.MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|uiMode|density|smallestScreenSize"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

            <!-- 必须与 platforms/android/Cargo.toml 的 [lib] name 一致，NativeActivity 会加载
                 lib<lib_name>.so 并调用其中的 android_main。
                 Must match [lib] name in platforms/android/Cargo.toml: NativeActivity loads
                 lib<lib_name>.so and calls its android_main. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="surfing_studio_android" />

            <!-- 启动入口必须用 MAIN + LAUNCHER，否则安装后不会出现在桌面/应用列表；
                 android.app.NativeActivity 只是系统内部的动作名，不能当作启动 action。
                 The launcher entry must use MAIN + LAUNCHER, otherwise the app never shows up in
                 the home screen or app list; android.app.NativeActivity is an internal action name,
                 not a launcher action. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
